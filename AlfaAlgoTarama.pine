/////// TRANSFORM SIGNALS START HERE //////////

STO = false//input(false, title = 'Show STOCHASTIC Line?')
RSI = true//input(true, title = 'Show RSI Line?')
CCI = true//input(true, title = 'Show CCI Line?')
MFI = false//input(false, title = 'Show MFI Line?')
//Average means: average value of all 4 inverse fisher trasformed indicators
AVERAGE = false//input(false, title = 'Show AVERAGE Line?')

ccilength = input(8, 'CCI Length')
wmalength = input(13, title = 'Smoothing Length')
v11 = 0.1 * (ta.cci(close, ccilength) / 4)
v21 = ta.wma(v11, wmalength)
INV1 = (math.exp(2 * v21) - 1) / (math.exp(2 * v21) + 1)
rsilength = input(8, 'RSI Length')
v12 = 0.1 * (ta.rsi(close, rsilength) - 50)
v22 = ta.wma(v12, wmalength)
INV2 = (math.exp(2 * v22) - 1) / (math.exp(2 * v22) + 1)
stochlength = input(8, 'STOCH Length')
v1 = 0.1 * (ta.stoch(close, high, low, stochlength) - 50)
v2 = ta.wma(v1, wmalength)
INVLine = (math.exp(2 * v2) - 1) / (math.exp(2 * v2) + 1)
//MFI
mfilength = input(8, 'MFI Length')
source = hlc3
up = math.sum(volume * (ta.change(source) <= 0 ? 0 : source), mfilength)
lo = math.sum(volume * (ta.change(source) >= 0 ? 0 : source), mfilength)
mfi = 100.0 - 100.0 / (1.0 + up / lo)
v13 = 0.1 * (mfi - 50)
v23 = ta.wma(v13, wmalength)
INV3 = (math.exp(2 * v23) - 1) / (math.exp(2 * v23) + 1)
AVINV = (INV1 + INV2 + INVLine + INV3) / 4

//plot(AVERAGE and bool(AVINV) ? AVINV : na, color = color.new(color.purple, 0), linewidth = 3, title = 'AVERAGE')
//plot(STO and bool(INVLine) ? INVLine : na, color = color.new(color.blue, 0), linewidth = 1, title = 'STOCH')
//plot(CCI and bool(INV1) ? INV1 : na, color = color.new(color.red, 0), linewidth = 3, title = 'CCIv2')
//plot(RSI and bool(INV2) ? INV2 : na, color = color.new(color.black, 0), linewidth = 2, title = 'RSI')
//plot(MFI and bool(INV3) ? INV3 : na, color = color.new(color.purple, 0), linewidth = 2, title = 'MFI')
hline(0.5, color = color.red)
hline(-0.5, color = color.green)

// Trend belirleme
fastMA = ta.ema(close, 5)
slowMA = ta.ema(close, 13)
trend = fastMA > slowMA ? 1 : fastMA < slowMA ? -1 : 0

// Sinyal arası minimum bar sayısı
minBarsBetwenSignals = 3
var lastSignalBar = 0
var lastSignalType = 0 // 1 for long, -1 for short

// Momentum ve Hacim Hesaplamaları
roc = ta.roc(close, 3) // 3 bara düşürdük
volMA = ta.sma(volume, 10) // 10 bara düşürdük
isVolHigh = volume > volMA * 0.8 // Hacim koşulunu yumuşattık

// Eğim Hesaplamaları
cci_slope = INV1 - INV1[2] // 2 bar öncesi ile karşılaştırma
rsi_slope = INV2 - INV2[2]

// CCI RSI kesişim koşulları
TRSlongCondition = INV1 < -0.5 and INV2 < -0.5 and ta.crossover(INV1, INV2) and (cci_slope > -0.1 or rsi_slope > -0.1) and (trend == 1 or roc > -0.2) and isVolHigh // Seviyeler aynı ta.crossover(INV1,INV2) and           // Kesişim (cci_slope > -0.1 or rsi_slope > -0.1) and  // En az biri yukarı eğilimli (trend == 1 or roc > -0.2) and        // Trend yukarı veya momentum çok negatif değil isVolHigh                             // Hacim yeterli

TRSshortCondition = INV1 > 0.5 and INV2 > 0.5 and ta.crossunder(INV1, INV2) and (cci_slope < 0.1 or rsi_slope < 0.1) and (trend == -1 or roc < 0.2) and isVolHigh // Seviyeler aynı ta.crossunder(INV1,INV2) and        // Kesişim (cci_slope < 0.1 or rsi_slope < 0.1) and  // En az biri aşağı eğilimli (trend == -1 or roc < 0.2) and      // Trend aşağı veya momentum çok pozitif değil isVolHigh                           // Hacim yeterli

// Sinyal durumunu güncelle
if TRSlongCondition and TRS_al==true and bar_index - lastSignalBar > minBarsBetwenSignals
    lastSignalBar := bar_index
    lastSignalType := 1
    lastSignalType
if TRSshortCondition and bar_index - lastSignalBar > minBarsBetwenSignals
    lastSignalBar := bar_index
    lastSignalType := -1
    lastSignalType

// Plot signals
plotshape(TRS_al==true and  TRSlongCondition, title = 'Long Signal', text = 'LONG', style = shape.triangleup, location = location.belowbar, color = color.green, size = size.small, force_overlay = true)
plotshape(TRS_al==true and  TRSshortCondition, title = 'Short Signal', text = 'SHORT', style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small, force_overlay = true)

// CCI ve RSI kesişim çizgileri
//plot(INV1, color = color.red, linewidth = 2, title = 'CCI Line')
//plot(INV2, color = color.black, linewidth = 2, title = 'RSI Line')

// Alert messages
alertcondition(TRS_al==true and  TRSlongCondition, title = 'TRS Buy', message = 'LONG Signal - CCI/RSI Crossover with Trend!')
alertcondition(TRS_al==true and  TRSshortCondition, title = 'TRS Sell', message = 'SHORT Signal - CCI/RSI Crossover with Trend!')



/////// TRANSFORM SIGNALS END HERE ////////////////

////////////////// Auto Trend Line Start Here ///////////////////

//// Trend line and BreakOut Setup /////////
//import HoanGhetti/SimpleTrendlines/5 as tl
import coinfxpro/SimpleTrendlines/1

input_len       = input.int(defval = 50, title = 'TrendLine Pivot Length', minval = 1)
input_pivotType = 'Normal'//input.string(defval = 'Normal', title = 'Pivot Type', options = ['Normal', 'Fast'], tooltip = 'Normal: Uses Pine\'s built-in pivot system.\n\nFast: Uses a custom pivot system that tracks every reversal.')
input_repaint   = false//input.bool(defval = true, title = 'Repainting', tooltip = 'If disabled, it will wait for bar confirmation to avoid printing false alerts.')
input_targets   = false//input.bool(defval = false, title = 'Target Levels')
input_bearC     = color.red//input.color(defval = color.red, title = 'Bear Breakout', group = 'Styling')
input_bullC     = color.green//input.color(defval = color.green, title = 'Bull Breakout', group = 'Styling')
input_extend    = extend.none//input.string(defval = extend.none, title = 'Extend', options = [extend.none, extend.right, extend.left, extend.both], group = 'Styling')
input_style     = line.style_dotted//input.string(defval = line.style_dotted, title = 'Trendline Style', options = [line.style_dotted, line.style_dashed, line.style_solid], group = 'Styling')
input_tstyle    = line.style_dashed//input.string(defval = line.style_dashed, title = 'Target Style', options = [line.style_dotted, line.style_dashed, line.style_solid], group = 'Styling')
input_override  = false//input.bool(defval = false, title = 'Override Source', group = 'Override', tooltip = 'Overriding the source will allow the script to create trendlines on any specified source.')
input_useSrc    = true//input.bool(defval = true, title = 'Use Source for Cross Detection', group = 'Override', tooltip = 'Instead of checking if the close value crossed trendline, check for the specified source.')
input_source    = close//input.source(defval = low, title = 'Source', group = 'Override')

plx = fixnan(ta.pivotlow(input_override ? input_source : low, input_pivotType == 'Normal' ? input_len : 1, input_len))
phx = fixnan(ta.pivothigh(input_override ? input_source : high, input_pivotType == 'Normal' ? input_len : 1, input_len))

pivot(float pType) =>
    pivot = pType == plx ? plx : phx
    xAxis = ta.valuewhen(ta.change(pivot), bar_index, 0) - ta.valuewhen(ta.change(pivot), bar_index, 1)
    prevPivot = ta.valuewhen(ta.change(pivot), pivot, 1)
    pivotCond = ta.change(pivot) and (pType == plx ? pivot > prevPivot : pivot < prevPivot)
    pData = SimpleTrendlines.new(x_axis = xAxis, offset = input_len, strictMode = true, strictType = pType == plx ? 0 : 1)
    pData.drawLine(pivotCond, prevPivot, pivot, input_override ? input_source : na)
    pData

breakout(SimpleTrendlines.Trendline this, float pType) =>
    var bool hasCrossed = false
    if ta.change(this.lines.startline.get_y1())
        hasCrossed := false
    this.drawTrendline(not hasCrossed)
    confirmation = not hasCrossed and (input_repaint ? not hasCrossed : barstate.isconfirmed)
    if (pType == plx ? (input_override and input_useSrc ? input_source : close) < this.lines.trendline.get_y2() : (input_override and input_useSrc ? input_source : close) > this.lines.trendline.get_y2()) and confirmation
        hasCrossed := true
        this.lines.startline.set_xy2(this.lines.trendline.get_x2(), this.lines.trendline.get_y2())
        this.lines.trendline.set_xy2(na, na)
        this.lines.startline.copy()
    hasCrossed

plData = pivot(plx)
phData = pivot(phx)

style(SimpleTrendlines.Trendline this, color col) =>
    this.lines.startline.set_color(col), this.lines.trendline.set_color(col)
    this.lines.startline.set_width(2), this.lines.trendline.set_width(2)
    this.lines.trendline.set_style(input_style), this.lines.trendline.set_extend(input_extend)
style(plData, input_bearC), style(phData, input_bullC)

cu = breakout(plData, plx)
co = breakout(phData, phx)
plotshape(ta.change(cu) and cu ? plData.lines.startline.get_y2() : na, title = 'Bearish Breakout', style = shape.labeldown, color = input_bearC, textcolor = color.white, location = location.absolute, text = 'Br')
plotshape(ta.change(co) and co ? phData.lines.startline.get_y2() : na, title = 'Bullish Breakout', style = shape.labelup, color = input_bullC, textcolor = color.white, location = location.absolute, text = 'Br')

recent_bull_breakout = ta.barssince(ta.change(co) and co) <= 3
recent_bear_breakout = ta.barssince(ta.change(cu) and cu) <= 3



alertcondition(recent_bear_breakout, 'Bearish Breakout')
alertcondition(recent_bull_breakout, 'Bullish Breakout')
//plotchar( ta.change(co) and co ? phData.lines.startline.get_y2() : na,title= 'CrossBreakout Buy Signal',location= location.belowbar,offset=1, color = color.green, size=size.tiny,char='🔷')
//plotchar( ta.change(cu) and cu ? plData.lines.startline.get_y2() : na,title= 'CrossBreakout Sell Signal',location= location.abovebar,offset=1, color = color.red, size=size.tiny,char='⛔️')


//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///                                             XU100 Seans Filtresi Modülü                                            ///
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// =============== SEANS FİLTRESİ AYARLARI ===============
use_session_filter = input.bool(true, "XU100 Seans Filtresi Kullan", group="Seans Filtresi")
xu100_symbol = input.string("BIST:XU100", "XU100 Sembolü", group="Seans Filtresi")
session_tf = input.string("1", "Takip Periyodu", options=["1", "5"], group="Seans Filtresi")
sensitivity = input.float(2.0, "Anomali Hassasiyeti", minval=0.5, maxval=5.0, step=0.5, group="Seans Filtresi")
show_session_table = input.bool(true, "Seans Durumu Tablosu Göster", group="Seans Filtresi")

// =============== XU100 VERİLERİNİ ÇEK ===============
// XU100 endeksinin anlık verilerini çek
[xu100_close, xu100_open, xu100_high, xu100_low, xu100_volume] = request.security(xu100_symbol, session_tf, [close, open, high, low, volume])

// Önceki günün kapanış fiyatı
xu100_prev_close = request.security(xu100_symbol, "1D", close[1])

// =============== SEANS KONTROLÜ ===============
// Türkiye saati kontrolü (UTC+3)
turkey_time = time + 3 * 60 * 60 * 1000
is_session_open = hour(turkey_time) >= 10 and hour(turkey_time) < 21 and dayofweek != dayofweek.saturday and dayofweek != dayofweek.sunday

// Seans açılışı tespit et
session_start = is_session_open and not is_session_open[1]

// =============== PIYASA ANALİZİ ===============
// Günlük değişim hesapla
daily_change_pct = xu100_prev_close > 0 ? (xu100_close - xu100_prev_close) / xu100_prev_close * 100 : 0

// Açılış gapı
opening_gap = xu100_prev_close > 0 ? (xu100_open - xu100_prev_close) / xu100_prev_close * 100 : 0

// Anlık momentum hesaplama
xu100_roc_5 = ta.roc(xu100_close, 5)  // 5 periyot ROC
xu100_roc_15 = ta.roc(xu100_close, 15) // 15 periyot ROC
xu100_sma_20 = ta.sma(xu100_close, 20)
xu100_above_sma = xu100_close > xu100_sma_20

// Volatilite hesaplama (son 20 periyot)
xu100_volatility = ta.stdev(ta.roc(xu100_close, 1), 20)
avg_volatility = ta.sma(xu100_volatility, 50)
high_volatility = xu100_volatility > avg_volatility * sensitivity

// Hacim analizi
xu100_vol_sma = ta.sma(xu100_volume, 20)
high_volume = xu100_volume > xu100_vol_sma * 1.5

// =============== ANOMALI TESPİTİ ===============
// Ani düşüş tespit et
sharp_decline = xu100_roc_5 < -1.5 and xu100_roc_15 < -2.0
moderate_decline = xu100_roc_5 < -0.8 and xu100_roc_15 < -1.2

// Güçlü satış baskısı
strong_selling = sharp_decline and high_volume and high_volatility
moderate_selling = moderate_decline and (high_volume or high_volatility)

// Pozitif momentum
positive_momentum = xu100_roc_5 > 0.3 and xu100_roc_15 > 0 and xu100_above_sma
neutral_momentum = xu100_roc_5 > -0.5 and xu100_roc_5 < 0.5 and not high_volatility

// =============== PIYASA DURUMU BELİRLE ===============
var string market_status = "Analiz Ediliyor"
var color status_color = color.yellow

if is_session_open
    if strong_selling
        market_status := "GÜÇLÜ SATIŞ!"
        status_color := color.red
    else if moderate_selling
        market_status := "Satış Baskısı"
        status_color := color.orange
    else if positive_momentum
        market_status := "Pozitif Trend"
        status_color := color.green
    else if neutral_momentum
        market_status := "Normal Seyir"
        status_color := color.blue
    else
        market_status := "Kararsız Piyasa"
        status_color := color.yellow
else
    market_status := "Seans Kapalı"
    status_color := color.gray

// =============== SİNYAL FİLTRESİ ===============
// Sinyallerin aktif olup olmayacağını belirle
signals_active = true

if use_session_filter and is_session_open
    signals_active := not strong_selling and not moderate_selling
else if use_session_filter and not is_session_open
    signals_active := false

// Alarm durumu
var bool alarm_sent = false
if strong_selling and not alarm_sent
    alarm_sent := true
    alert("XU100 UYARI: Güçlü satış baskısı tespit edildi!", alert.freq_once_per_bar)

if not strong_selling
    alarm_sent := false



// =============== GELİŞTİRİLMİŞ UYARI SİSTEMİ ===============
// Çoklu uyarı sistemi
alert_strong_selling = strong_selling and not strong_selling[1]
alert_positive_turn = positive_momentum and not positive_momentum[1] and strong_selling[1]

alertcondition(alert_strong_selling, title='XU100 Güçlü Satış Uyarısı', 
               message='XU100 endeksinde güçlü satış baskısı! Alım sinyalleri devre dışı.')
               
alertcondition(alert_positive_turn, title='XU100 Toparlanma Uyarısı', 
               message='XU100 endeksinde toparlanma başladı. Sinyaller tekrar aktif.')

// =============== SINYAL KOŞULLARINI GÜNCELLE ===============
// Mevcut sinyal koşullarınıza signals_active filtresini ekleyin:

// Örnek kullanım (mevcut kodunuzdaki sinyal koşullarını şu şekilde güncelleyin):
// Orijinal sinyal koşullarınız:
//al_kosulu = z < under_high and z > under_low and k< rsi_os and srsi_long and cur_cond and cond_gold_rate

// Seans filtreli yeni hali:
//al_kosulu = z < under_high and z > under_low and k< rsi_os and srsi_long and cur_cond and cond_gold_rate and signals_active


// Bu kodda sizin orijinal kodunuza eklemeler yapıyorum
// Mevcut değişkenlerinizin altına eklenecek yeni bölümler:

// =============== 2. VIX BENZERİ KORKU ENDEKSİ ===============
// XU100 için örtük volatilite hesabı
xu100_atr = request.security(xu100_symbol, session_tf, ta.atr(14))
xu100_atr_ma = request.security(xu100_symbol, session_tf, ta.sma(xu100_atr, 20))
fear_index = xu100_atr_ma > 0 ? xu100_atr / xu100_atr_ma : 1
extreme_fear = fear_index > 2
high_fear = fear_index > 1.5
normal_fear = fear_index <= 1.5 and fear_index >= 0.8
low_fear = fear_index < 0.8

// Fear index durumu
var string fear_status = "Normal"
var color fear_color = color.green
if extreme_fear
    fear_status := "EXTREME!"
    fear_color := color.red
else if high_fear
    fear_status := "Yüksek"
    fear_color := color.orange
else if normal_fear
    fear_status := "Normal"
    fear_color := color.blue
else
    fear_status := "Düşük"
    fear_color := color.green

// =============== 3. GÜN İÇİ MOMENTUM PATERNİ ===============
// Seans açılışından itibaren momentum takibi
bars_since_open = ta.barssince(session_start)
intraday_momentum = bars_since_open > 0 and xu100_open > 0 ? 
     (xu100_close - xu100_open) / xu100_open * 100 : 0

// Açılış rallisi veya satışı tespiti
opening_rally = intraday_momentum > 1 and bars_since_open < 30
opening_dump = intraday_momentum < -1 and bars_since_open < 30
sideways_open = not opening_rally and not opening_dump and bars_since_open < 30

// Gün içi trend
var string intraday_trend = "Yatay"
var color trend_color = color.gray
if intraday_momentum > 0.5
    intraday_trend := "Yükseliş"
    trend_color := color.green
else if intraday_momentum < -0.5
    intraday_trend := "Düşüş"
    trend_color := color.red
else
    intraday_trend := "Yatay"
    trend_color := color.gray

// =============== 4. AKILLI GAP ANALİZİ ===============
// Gap tipi belirleme
gap_type = opening_gap > 1.5 ? "Breakaway" : 
           opening_gap > 0.5 ? "Common" :
           opening_gap < -1.5 ? "Exhaustion" : 
           opening_gap < -0.5 ? "Common" : "No Gap"

// Gap rengi
gap_color = opening_gap > 0.5 ? color.green : 
             opening_gap < -0.5 ? color.red : color.gray

// Gap kapanma takibi
gap_filled = xu100_prev_close > 0 and 
     ((opening_gap > 0 and xu100_low <= xu100_prev_close) or 
     (opening_gap < 0 and xu100_high >= xu100_prev_close))

gap_fill_status = gap_filled ? "Kapandı" : "Açık"
gap_fill_color = gap_filled ? color.blue : color.orange

// =============== 5. MARKET BREADTH (PİYASA GENİŞLİĞİ) ===============
// Yükselen/düşen sektör oranı
[xbank_close, xbank_open] = request.security("BIST:XBANK", session_tf, [close, open])
[xusin_close, xusin_open] = request.security("BIST:XUSIN", session_tf, [close, open])
[xutek_close, xutek_open] = request.security("BIST:XUTEK", session_tf, [close, open])
[xgida_close, xgida_open] = request.security("BIST:XGIDA", session_tf, [close, open])

banking_up = xbank_close > xbank_open
industrial_up = xusin_close > xusin_open
tech_up = xutek_close > xutek_open
food_up = xgida_close > xgida_open

sectors_up = (banking_up ? 1 : 0) + (industrial_up ? 1 : 0) + 
             (tech_up ? 1 : 0) + (food_up ? 1 : 0)
total_sectors = 4

market_breadth = (sectors_up / total_sectors) * 100
breadth_status = market_breadth >= 75 ? "Çok Güçlü" :
                 market_breadth >= 50 ? "Güçlü" :
                 market_breadth >= 25 ? "Zayıf" : "Çok Zayıf"
                 
breadth_color = market_breadth >= 75 ? color.green :
                 market_breadth >= 50 ? color.lime :
                 market_breadth >= 25 ? color.orange : color.red

xbank_daily_change_pct = xbank_close[1] > 0 ? (xbank_close - xbank_close[1]) / xbank_close[1] * 100 : 0
xusin_daily_change_pct = xusin_close[1] > 0 ? (xusin_close - xusin_close[1]) / xusin_close[1] * 100 : 0
xutek_daily_change_pct = xutek_close[1] > 0 ? (xutek_close - xutek_close[1]) / xutek_close[1] * 100 : 0
xgida_daily_change_pct = xgida_close[1] > 0 ? (xgida_close - xgida_close[1]) / xgida_close[1] * 100 : 0

// =============== 6. ADAPTİF HASSASİYET ===============
// Volatiliteye göre hassasiyet ayarı
adaptive_sensitivity = xu100_volatility > avg_volatility * 2 ? 
     math.max(sensitivity * 0.7, 1) : 
     xu100_volatility < avg_volatility * 0.5 ? 
     math.min(sensitivity * 1.3, 3) : sensitivity

sensitivity_status = adaptive_sensitivity < sensitivity ? "Azaltıldı" :
                     adaptive_sensitivity > sensitivity ? "Artırıldı" : "Normal"
sensitivity_color = adaptive_sensitivity < sensitivity ? color.orange :
                   adaptive_sensitivity > sensitivity ? color.red : color.blue

// =============== 7. SİNYAL GÜVENİLİRLİK SKORU ===============
// Her sinyal için güvenilirlik hesapla
signal_reliability = 0.0

// Piyasa durumu pozitifse +1
signal_reliability += positive_momentum ? 1 : 0

// Volatilite normalse +1  
signal_reliability += not high_volatility ? 1 : 0

// Hacim destekliyorsa +1
signal_reliability += high_volume and positive_momentum ? 1 : 0

// Fear Index normalse +1
signal_reliability += not high_fear and not extreme_fear ? 1 : 0

// Market breadth güçlüyse +1
signal_reliability += market_breadth >= 50 ? 1 : 0

// Toplam skor (0-5 arası)
signal_strength = signal_reliability >= 4 ? "ÇOK GÜÇLÜ" : 
                 signal_reliability >= 3 ? "GÜÇLÜ" : 
                 signal_reliability >= 2 ? "ORTA" : 
                 signal_reliability >= 1 ? "ZAYIF" : "ÇOK ZAYIF"

strength_color = signal_reliability >= 4 ? color.green : 
                 signal_reliability >= 3 ? color.lime : 
                 signal_reliability >= 2 ? color.yellow : 
                 signal_reliability >= 1 ? color.orange : color.red



// Telegram mesajına ek bilgiler
market_analysis_text = "\\n\\n📊 *BIST Genel Görünüm*" +
                      "\\n├ Durum: " + market_status +
                      "\\n├ Fear Index: " + fear_status + " (" + str.tostring(fear_index, "#.##") + ")" +
                      "\\n├ Gün İçi Trend: " + intraday_trend + " (%" + str.tostring(intraday_momentum, "#.##") + ")" +
                      "\\n├ Gap: " + gap_type + " - " + gap_fill_status +
                      "\\n├ Sektör Durum: " + breadth_status + " (" + str.tostring(sectors_up) + "/4)" +
                      "\\n└ Sinyal Kalitesi: " + signal_strength + " ⭐" + str.tostring(signal_reliability, "#")

// ====== YENİ EKLEME: DİP HESAPLAMALARI ======
// Son 3 aylık (yaklaşık 63 işlem günü) en düşük değer
low_3month = request.security(syminfo.tickerid, "1D", ta.lowest(low, 63))
// Yıllık (yaklaşık 252 işlem günü) en düşük değer  
low_1year = request.security(syminfo.tickerid, "1D", ta.lowest(low, 252))

// Dibe uzaklık yüzdeleri
distance_3month = ((close - low_3month) / low_3month) * 100
distance_1year = ((close - low_1year) / low_1year) * 100

// Fiyat farkları (TL olarak)
price_diff_3month = close - low_3month
price_diff_1year = close - low_1year

// Dip değerlendirme fonksiyonu
getDipEvaluation(distance) =>
    if distance <= 5
        "🔥 Çok Yakın"
    else if distance <= 10
        "✅ Yakın"
    else if distance <= 20
        "⚠️ Orta"
    else
        "❌ Uzak"

// Dip değerlendirmeleri
eval_3month = getDipEvaluation(distance_3month)
eval_1year = getDipEvaluation(distance_1year)

// Dip analiz metni
dip_analysis_text = "\\n\\n📊 *Dip Analizi*" +
     "\\n┌─ *3 Aylık Analiz*" +
     "\\n├ Dip Değeri: " + str.tostring(low_3month, "#.##") + " TL" +
     "\\n├ Mevcut Fiyat: " + str.tostring(close, "#.##") + " TL" +
     "\\n├ Fark: " + str.tostring(price_diff_3month, "#.##") + " TL" +
     "\\n├ Uzaklık: %" + str.tostring(distance_3month, "#.##") + " " + eval_3month +
     "\\n│" +
     "\\n├─ *Yıllık Analiz*" +
     "\\n├ Dip Değeri: " + str.tostring(low_1year, "#.##") + " TL" +
     "\\n├ Mevcut Fiyat: " + str.tostring(close, "#.##") + " TL" +
     "\\n├ Fark: " + str.tostring(price_diff_1year, "#.##") + " TL" +
     "\\n└ Uzaklık: %" + str.tostring(distance_1year, "#.##") + " " + eval_1year

// Sinyal değerlendirme skoru (0-100)
signal_score = 50  // Başlangıç skoru

// Dip uzaklığına göre skor ayarlama
if distance_3month <= 5
    signal_score := signal_score + 25
else if distance_3month <= 10
    signal_score := signal_score + 15
else if distance_3month <= 20
    signal_score := signal_score + 5

if distance_1year <= 10
    signal_score := signal_score + 25
else if distance_1year <= 20
    signal_score := signal_score + 15
else if distance_1year <= 30
    signal_score := signal_score + 5

// Sinyal gücü değerlendirmesi
signal_strength_deep = signal_score >= 90 ? "💎 Mükemmel" : 
                 signal_score >= 75 ? "🚀 Çok İyi" :
                 signal_score >= 60 ? "✅ İyi" :
                 signal_score >= 40 ? "⚠️ Orta" : "❌ Zayıf"


alSinyal = (dip_buy_signal and dip_al==true) or (fish_buy_signal and fish_al==true) or (ma_buy_signal and ma_buy==true) or (Boga_Uyumsuzluk and boga_al==true) or 
     (Boga_Gizli_Uyumsuzluk and boga_uyumsuzluk_al==true) or (Vision_Al and vision_al==true) or (ma_cross_long and ma_cross_al==true) or (TRSlongCondition and TRS_al==true)
satSinyal = sellCondition
sinyal = alSinyal ? close : satSinyal ? close * -1 : 0

dipText = "[Borsa Yardımcısı]  Potansiyel Dip Sinyali. EMA377 Seviyesi test edilebilir. Diğer kontrolleri yapın."
tepeText = "[Borsa Yardımcısı] Hisse EMA377 seviyesini yukarı kırdı. Dönüş potansiyeli için grafiği kontrol edin."

fish_buy_signal_text = "Potansiyel Fish Alım Sinyali. Diğer kontrolleri yapın."
