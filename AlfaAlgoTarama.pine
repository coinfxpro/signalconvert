///////////// Fisher Condition //////////

// Fonksiyonlar
fisher_transform(src, length) =>
    // Fisher Transform hesaplaması
    hi = ta.highest(src, length)
    lo = ta.lowest(src, length)
    raw_value = 0.0
    raw_value := 0.66 * ((src - lo) / (hi - lo) - 0.5) + 0.67 * nz(raw_value[1])
    bounded_value = math.min(math.max(raw_value, -0.999), 0.999)
    fish = 0.0
    fish := 0.5 * math.log((1 + bounded_value) / (1 - bounded_value)) + 0.5 * nz(fish[1])
    fish

fisher_transform_signal(src, length) =>
    fish = fisher_transform(src, length)
    fish[1]

