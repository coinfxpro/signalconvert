// Girdi değerleri
RPD = input(30, title="RSI Period")
SPD = input(30, title="Stochastic Period")
PK = 3//input(3, title="K Period")
S = 3//input(3, title="Smoothing Period")

// Stochastic RSI hesaplaması
rsiValueX = ta.rsi(close, RPD)
stochRsi = (rsiValueX - ta.lowest(rsiValueX, SPD)) / (ta.highest(rsiValueX, SPD) - ta.lowest(rsiValueX, SPD)) * 100
K = ta.sma(stochRsi, PK)
D = ta.sma(stochRsi, S)

// Koşulları Pine Script'e çevirme
///ADX cond //
adxlen = 14//input(14, title="ADX Smoothing")
dilen = 14//input(14, title="DI Length")
dirmov(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    truerange = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
    minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
    [plus, minus]
adx(dilen, adxlen) =>
    [plus, minus] = dirmov(dilen)
    sum = plus + minus
    adx = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)
sig = adx(dilen, adxlen)

/// ADX End ///
RSIPeriod = 14
volumePeriod = 10
rsiCross = ta.crossover(ta.rsi(close, RSIPeriod), 30)
sellrsiCross = ta.crossunder(ta.rsi(close, RSIPeriod), 70)
volumeCondition = volume / ta.sma(volume, volumePeriod) > 1
momentumCondition = ta.mom(close, volumePeriod) > -100
volumeAboveAverage = volume > ta.sma(volume, volumePeriod)
adxCondition = sig > 14

// Fibonacci Levels
