ma_buy_signal_text = "Potansiyel MA Cross Alım Sinyali. Diğer kontrolleri yapın."
//ma_sell_signal_text = "[Borsa Yardımcısı]  Potansiyel MA Cross Sinyali. Diğer kontrolleri yapın."
dip_buy_signal_text = "Potansiyel Dip Alım Sinyali. Diğer kontrolleri yapın."
//tepe_sell_signal_text = "[Borsa Yardımcısı]  Potansiyel Tepe Satım Sinyali. Diğer kontrolleri yapın."

boga_uyumsuzluk_text = "Potansiyel Boğa Uyumsuzluk Sinyali. Diğer kontrolleri yapın."
gizli_boga_uyumsuzluk_text = "Potansiyel Gizli Boğa Uyumsuzluk Sinyali. Diğer kontrolleri yapın."
