Change_of_WT = ta.barssince(Change_of_direction) <=2
alertcondition(Change_of_WT, title='Change In Direction WT')

plotshape(boga_al==true and BullSale ? wt2[1] - ploff : na, title='Bull_to_Bear TakeOver', text='Bear', location=location.abovebar, style=shape.labeldown, size=size.tiny, color=color.new(Bearish, 0), textcolor=color.new(White, 0),force_overlay = true)
plotshape(boga_al==true and Bullishh ? wt2[1] + ploff : na, title='Bear_to_Bull TakeOver', text='Bull', location=location.belowbar, style=shape.labelup, size=size.tiny, color=color.new(Bullish, 0), textcolor=color.new(White, 0),force_overlay = true)

plotshape(boga_uyumsuzluk_al==true and hidden_bullish_div1 and divhidbull and Tags ? wt1[1] - ploff * 1 : na, title='Bull_to_Bear TakeOver', text='HD_Bear', location=location.abovebar, style=shape.labeldown, size=size.tiny, color=color.new(Bearish, 0), textcolor=color.new(White, 0),force_overlay = true)
plotshape(boga_uyumsuzluk_al==true and hidden_bearish_div1 and divhidbear and Tags ? wt1[1] + ploff * 1 : na, title='Bear_to_Bull TakeOver', text='HD_Bull', location=location.belowbar, style=shape.labelup, size=size.tiny, color=color.new(Bullish, 0), textcolor=color.new(White, 0),force_overlay = true)

/////// Extra Alerts //////

