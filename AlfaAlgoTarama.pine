//symbol= input.symbol(close)



periodText = "PERİYOT : "
fiyatText = "FİYAT : "
kontrol = "Grafiği Kontrol edin! "
gunluk_degisim= "Günlük değişim: "
//alarmTetikle(symbol)=>
//    durum = request.security(syminfo.tickerid,timeframe.period,condition, ignore_invalid_symbol = true)
//    mesaj = fish_buy_signal==1?fish_buy_signal_text : ma_buy_signal==1 ? ma_buy_signal_text : dip_buy_signal==1 ? dip_buy_signal_text : Boga_Uyumsuzluk==1 ? boga_uyumsuzluk_text :  ""
//    timeinnow= "{{timenow}}"
//    if durum != 0 and str.length(syminfo.tickerid) > 1 // herhangi bir sinyal var ise yani
//        alarmMesajiJSON = "<strong>"+ syminfo.tickerid+"</strong>" +" => "+mesaj +"\\n" + periodText + timeframe.period +" DK"+ "\\n" +fiyatText + str.tostring(math.round(math.abs(durum),2)) + "\\n" +kontrol
//      
//        reply = ',"reply_markup":{"inline_keyboard":[[{"text":"📉 Tradingview","url":"https://www.tradingview.com/chart/?symbol='+syminfo.tickerid+'"}]]}'
//        if telegramSend
//           alert(message='{"chat_id":"'+grupid+'","text":"'+alarmMesajiJSON+'","parse_mode":"html"'+reply+'}',freq =  i_alert_mode)
//        else
//            alert(message = syminfo.tickerid + " hissesinde sinyal : " + mesaj)
onceki_gun=request.security(syminfo.tickerid,"1D",(close[1]))
gunluk=request.security(syminfo.tickerid,timeframe.period,(close-onceki_gun)/onceki_gun*100)
sma_500= request.security(syminfo.tickerid,"1D", ta.sma(close,500))
sma_200= request.security(syminfo.tickerid,"1D", ta.sma(close,200))
sma_50 = request.security(syminfo.tickerid,"1D", ta.sma(close,50))
rsi_value= request.security(syminfo.tickerid,timeframe.period, ta.rsi(close,14))

ema_10= request.security(syminfo.tickerid,timeframe.period, ta.ema(close,10))
ema_21 = request.security(syminfo.tickerid,"1D", ta.ema(close,21))


durum = request.security(syminfo.tickerid,timeframe.period,alSinyal, ignore_invalid_symbol = true)
mesaj = fish_buy_signal==1 ? fish_buy_signal_text : ma_cross_long==1 ? ma_cross_buy_signal_text : ma_buy_signal==1 ? ma_buy_signal_text : dip_buy_signal==1 ? dip_buy_signal_text : Boga_Uyumsuzluk==1 ? boga_uyumsuzluk_text : Boga_Gizli_Uyumsuzluk==1 ? gizli_boga_uyumsuzluk_text :
     Vision_Al==1 ? vision_al_text : TRSlongCondition==1 ? TRSlongCondition_text : recent_bull_breakout==1 ? bull_breakout_text :  ""
timeinnow= "{{timenow}}"
if durum != 0 and str.length(syminfo.tickerid) > 1// herhangi bir sinyal var ise yani
    alarmMesajiJSON = "<strong>"+ syminfo.ticker(syminfo.tickerid)+"</strong>" +" => "+mesaj +"\\n" + periodText + str.tostring(timeframe.period) +" DK"+ "\\n" +fiyatText + str.tostring(close) + "\\n" +kontrol + "\\n"
         + "\\n" +gunluk_degisim + "%" + str.tostring(gunluk, "#.##") + " " + (gunluk>0 ? " 🟢" : gunluk<0 ? " 🛑" : "") 
         + "\\n" + "Günlük 500SMA: " + str.tostring(sma_500,"#.##") + " " + (close > sma_500 ? " 🟢" : close < sma_500 ? " 🛑" : "") 
         + "\\n" + "Günlük 200SMA: " + str.tostring(sma_200,"#.##") + " " + (close > sma_200 ? " 🟢" : close < sma_200 ? " 🛑" : "") 
         + "\\n" + "Günlük 50SMA: " + str.tostring(sma_50,"#.##") + " " + (close > sma_50 ? " 🟢" : close < sma_50 ? " 🛑" : "")
         + "\\n" + "Günlük Ema21: " + str.tostring(ema_21,"#.##") + " " + (close > ema_21 ? " 🟢" : close < ema_21 ? " 🛑" : "")
         + "\\n" + "Fiyat EMA21 Günlük seviyenin " + "" + (close > ema_21 ? "Üstünde" : close < ema_21 ? "Altında" : "")
         + "\\n" + "RSI: " + str.tostring(rsi_value,"#.##") + " " + (rsi_value < 30 ? " 🟢" : rsi_value > 70 ? " 🛑" : " 🟡")
         + "\\n" + market_analysis_text 
         + "\\n" +dip_analysis_text + "\\n\\n" +  // YENİ EKLENEN DİP ANALİZİ
         "🎯 *Dip Analizi Değerlendirmesi*: " + signal_strength_deep  // YENİ EKLENEN GENEL DEĞERLENDİRME
    reply = ',"reply_markup":{"inline_keyboard":[[{"text":"📉 Tradingview","url":"https://www.tradingview.com/chart/?symbol='+syminfo.tickerid+'"}]]}'
    // SignalConvert webhook aktifken eski alert bloğu hiç çalışmaz (çift mesaj/boş kart önleme)
    if not use_signalconvert
        if telegramSend
            alert(message='{"chat_id":"'+grupid+'","text":"'+alarmMesajiJSON+'","parse_mode":"html"'+reply+'}',freq =  i_alert_mode)
        else
            alert(message = syminfo.ticker(syminfo.tickerid) + " hissesinde sinyal : " + mesaj)





