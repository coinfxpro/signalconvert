//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///                              SIGNALCONVERT WEBHOOK (Trade Kartı - Resim)                                            ///
///   Dip + Transform + Fish sinyallerini SignalConvert'e JSON gönderir; orada görsel karta dönüşür.                    ///
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

use_signalconvert = input.bool(true, "SignalConvert Webhook Aktif", group="SIGNALCONVERT")

// === Sinyal tetikleyici ===
sc_trigger = (dip_buy_signal and dip_al) or (fish_buy_signal and fish_al) or (TRSlongCondition and TRS_al)

// === Sinyal tipi (subtitle + tag) ===
sc_subtitle = dip_buy_signal ? "Potansiyel Dip Alım Sinyali" : fish_buy_signal ? "Potansiyel Fish Alım Sinyali" : TRSlongCondition ? "Potansiyel Transform Alım Sinyali" : "Sinyal"
sc_tag = dip_buy_signal ? "DIP" : fish_buy_signal ? "FISH" : TRSlongCondition ? "TRANSFORM" : "SIGNAL"

// === JSON payload — Pine'daki zaten hazır olan alanlardan ===
if sc_trigger and use_signalconvert and str.length(syminfo.tickerid) > 1
    sc_ema21_pos = close > ema_21 ? "Üstünde" : "Altında"
    sc_json = '{' +
         '"event":"ALGO_TARAMA"' +
         ',"symbol":"' + syminfo.ticker(syminfo.tickerid) + '"' +
         ',"subtitle":"' + sc_subtitle + '"' +
         ',"signal_tag":"' + sc_tag + '"' +
         ',"periyot":"' + str.tostring(timeframe.period) + ' DK"' +
         ',"price":' + str.tostring(close, "#.##") +
         ',"change_pct":' + str.tostring(gunluk, "#.##") +
         ',"rsi":' + str.tostring(rsi_value, "#.##") +
         ',"sma_500":' + str.tostring(sma_500, "#.##") +
         ',"sma_200":' + str.tostring(sma_200, "#.##") +
         ',"sma_50":' + str.tostring(sma_50, "#.##") +
         ',"ema_21":' + str.tostring(ema_21, "#.##") +
         ',"ema21_pos":"' + sc_ema21_pos + '"' +
         ',"market_status":"' + market_status + '"' +
         ',"fear_status":"' + fear_status + '"' +
         ',"fear_index":' + str.tostring(fear_index, "#.##") +
         ',"intraday_trend":"' + intraday_trend + '"' +
         ',"intraday_momentum":' + str.tostring(intraday_momentum, "#.##") +
         ',"gap_type":"' + gap_type + '"' +
         ',"gap_fill_status":"' + gap_fill_status + '"' +
         ',"breadth_status":"' + breadth_status + '"' +
         ',"sectors_up":' + str.tostring(sectors_up) +
         ',"signal_strength":"' + signal_strength + '"' +
         ',"signal_reliability":' + str.tostring(signal_reliability) +
         ',"low_3month":' + str.tostring(low_3month, "#.##") +
         ',"distance_3month":' + str.tostring(distance_3month, "#.##") +
         ',"price_diff_3month":' + str.tostring(price_diff_3month, "#.##") +
         ',"eval_3month":"' + eval_3month + '"' +
         ',"low_1year":' + str.tostring(low_1year, "#.##") +
         ',"distance_1year":' + str.tostring(distance_1year, "#.##") +
         ',"price_diff_1year":' + str.tostring(price_diff_1year, "#.##") +
         ',"eval_1year":"' + eval_1year + '"' +
         ',"signal_strength_deep":"' + signal_strength_deep + '"' +
         '}'
    alert(sc_json, freq = i_alert_mode)


