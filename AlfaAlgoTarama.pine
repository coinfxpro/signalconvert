bull_breakout_text = "Potansiyel Alım Bull BreakOut Sinyali. Diğer kontrolleri yapın."

ma_cross_buy_signal_text = "Alım Yönlü Hareketli ortalama kesişmesi. Diğer kontrolleri yapın."
ma_cross_sell_signal_text = "Satım Yönlü Hareketli Ortalama kesişmesi. Diğer kontrolleri yapın."

